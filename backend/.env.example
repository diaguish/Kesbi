# Copier en `.env` (jamais commité) et remplir. Sur Render : variables du service.

# --- Django ---
DJANGO_DEBUG=true
# Obligatoire hors DEBUG. Générer : python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
LOG_LEVEL=INFO

# --- Base de données ---
# Vide = SQLite local (db.sqlite3). Supabase : Project Settings > Database > Connection string,
# mode « Session pooler » (IPv4, compatible Render). Le mot de passe n'est jamais commité.
# DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# --- Supabase Auth ---
# Les JWT sont vérifiés via JWKS : <SUPABASE_URL>/auth/v1/.well-known/jwks.json
SUPABASE_URL=https://ubpvgafdhjnsimffybnd.supabase.co
# Uniquement si le projet signe encore ses JWT en HS256 (clé « legacy »). Sinon laisser vide.
SUPABASE_JWT_SECRET=
